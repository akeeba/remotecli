{
	"name": "akeeba/remotecli",
	"type": "project",
	"description": "Akeeba Remote Control CLI",
	"keywords": [
		"backup",
		"php",
		"mysql",
		"akeeba"
	],
	"homepage": "https://github.com/akeeba/remotecli",
	"license": "GPL-3.0+",
	"authors": [
		{
			"name": "Nicholas K. Dionysopoulos",
			"email": "nicholas_NO_SPAM_PLEASE@akeeba.com",
			"homepage": "https://www.dionysopoulos.me",
			"role": "Lead Developer"
		}
	],
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/akeeba/json-backup-api"
		}
	],
	"require": {
		"php": ">=8.2.0 <8.7",
		"ext-curl": "*",
		"ext-json": "*",
		"psr/log": "^3.0.0",
		"akeeba/json-backup-api": "^1.1.0",
		"composer/ca-bundle": "^1.2",
		"joomla/data": "^3.0.0",
		"joomla/http": "^3.0.0",
		"joomla/filesystem": "^3.0.0"
	},
	"suggest": {
		"ext-mbstring": "Allows for UTF8 encoding / decoding",
		"ext-intl": "Allows for UTF8 encoding / decoding",
		"ext-iconv": "Allows for UTF8 encoding / decoding"
	},
	"config": {
		"vendor-dir": "remotecli/vendor",
		"platform": {
			"php": "8.2.999"
		}
	},
	"autoload": {
		"psr-4": {
			"Akeeba\\RemoteCLI\\": "remotecli/"
		}
	},
	"extra": {
		"akcompat": {
			"locations": [
				{
					"file": "remotecli/remote.php",
					"type": "variable",
					"marker": "$minimumPhp",
					"value": "PHP_MIN"
				},
				{
					"file": "remotecli/remote.php",
					"type": "variable",
					"marker": "$maximumPhp",
					"value": "PHP_MAX"
				}
			]
		}
	}
}
